    "editorGroupHeader.tabsBackground": "#eef3f2",
    "editorGroupHeader.tabsBorder": "#cdddda",
    "editorGutter.background": "#e9f1ef",
    "editorIndentGuide.background1": "#cdddda",
    "editorLineNumber.activeForeground": "#d9ac0a",
    "editorLineNumber.foreground": "#6a807c",
    "editorWhitespace.foreground": "#cdddda",
    "editorWidget.background": "#eef3f2",
    "editorWidget.border": "#cdddda",
    "focusBorder": "#d9ac0a",
    "input.background": "#e9f1ef",
    "input.border": "#cdddda",
    "input.foreground": "#06C3C6",
    "list.activeSelectionBackground": "#d9ac0a2e",
    "list.hoverBackground": "#d9ac0a2e",
    "panel.background": "#e9f1ef",
    "panel.border": "#cdddda",
    "sideBar.background": "#eef3f2",
    "sideBar.border": "#cdddda",
    "sideBar.foreground": "#06C3C6",
    "sideBarSectionHeader.background": "#eef3f2",
    "sideBarTitle.foreground": "#6a807c",
    "statusBar.background": "#f5c518",
    "statusBar.border": "#cdddda",
    "statusBar.foreground": "#23262b",
    "tab.activeBackground": "#e9f1ef",
    "tab.activeBorderTop": "#d9ac0a",
    "tab.activeForeground": "#06C3C6",
    "tab.border": "#cdddda",
    "tab.inactiveBackground": "#eef3f2",
    "tab.inactiveForeground": "#6a807c",
    "terminal.background": "#e9f1ef",
    "terminal.foreground": "#06C3C6",
    "titleBar.activeBackground": "#f5c518",
    "titleBar.activeForeground": "#23262b",
    "titleBar.inactiveBackground": "#f5c518",
    "titleBar.inactiveForeground": "#6a807c"
  },
  "name": "Rusty Yellow Pages Light",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "attribute": {
      "foreground": "#752F00"
    },
    "boolean": {
      "foreground": "#0939C8"
    },
    "builtinType": {
      "foreground": "#2B6B73"
    },
    "comment": {
      "foreground": "#156C04",
      "italic": true
    },
    "constant": {
      "bold": true,
      "foreground": "#C29B00"
    },
    "decorator": {
      "foreground": "#752F00"
    },
    "enum": {
      "foreground": "#2B6B73"
    },
    "enum.declaration": {
      "bold": true,
      "foreground": "#1189DF"
    },
    "enumMember": {
      "foreground": "#8280FF"
    },
    "function": {
      "bold": true,
      "foreground": "#D9A98A"
    },
    "function.associated": {
      "bold": true,
      "foreground": "#F5A55A"
    },
    "function.declaration": {
      "bold": true,
      "foreground": "#9966A9"
    },
    "function.static": {
      "bold": true,
      "foreground": "#F5A55A"
    },
    "interface": {
      "bold": true,
      "foreground": "#019D59"
    },
    "interface.declaration": {
      "bold": true,
      "foreground": "#1189DF"
    },
    "keyword": {
      "foreground": "#FA0000"
    },
    "lifetime": {
      "foreground": "#FD4EDD",
      "italic": true
    },
    "macro": {
      "foreground": "#D972EE"
    },
    "method": {
      "bold": true,
      "foreground": "#7004C8"
    },
    "method.declaration": {
      "bold": true,
      "foreground": "#9966A9"
    },
    "method.static": {
      "bold": true,
      "foreground": "#F5A55A"
    },
    "namespace": {
      "foreground": "#AA261D"
    },
    "number": {
      "foreground": "#0939C8"
    },
    "operator": {
      "foreground": "#180070"
    },
    "parameter": {
      "foreground": "#06C3C6"
    },
    "property": {
      "foreground": "#8280FF"
    },
    "selfKeyword": {
      "foreground": "#FA0000"
    },
    "string": {
      "foreground": "#C23B24"
    },
    "struct": {
      "foreground": "#2B6B73"
    },
    "struct.declaration": {
      "bold": true,
      "foreground": "#1189DF"
    },
    "type": {
      "foreground": "#2B6B73"
    },
    "typeAlias": {
      "foreground": "#2B6B73"
    },
    "typeAlias.declaration": {
      "bold": true,
      "foreground": "#1189DF"
    },
    "typeParameter": {
      "foreground": "#C89797",
      "italic": true
    },
    "union": {
      "foreground": "#2B6B73"
    },
    "union.declaration": {
      "bold": true,
      "foreground": "#1189DF"
    },
    "variable": {
      "foreground": "#06C3C6"
    },
    "variable.constant": {
      "bold": true,
      "foreground": "#C29B00"
    },
    "variable.static": {
      "bold": true,
      "foreground": "#C29B00"
    }
  },
  "tokenColors": [
    {
      "name": "comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#156C04"
      }
    },
    {
      "name": "string",
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#C23B24"
      }
    },
    {
      "name": "number",
      "scope": [
        "constant.numeric",
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#0939C8"
      }
    },
    {
      "name": "keyword",
      "scope": [
        "keyword",
        "storage.modifier",
        "keyword.control"
      ],
      "settings": {
        "foreground": "#FA0000"
      }
    },
    {
      "name": "macro",
      "scope": [
        "entity.name.function.macro",
        "support.function.macro"
      ],
      "settings": {
        "foreground": "#D972EE"
      }
    },
    {
      "name": "attribute",
      "scope": [
        "meta.attribute",
        "punctuation.definition.attribute"
      ],
      "settings": {
        "foreground": "#752F00"
      }
    },
    {
      "name": "lifetime",
      "scope": [
        "storage.modifier.lifetime",
        "entity.name.type.lifetime"
      ],
      "settings": {
        "foreground": "#FD4EDD"
      }
    },
    {
      "name": "punct",
      "scope": [
        "keyword.operator",
        "punctuation"
      ],
      "settings": {
        "foreground": "#180070"
      }
    }
  ],
  "type": "light"
}