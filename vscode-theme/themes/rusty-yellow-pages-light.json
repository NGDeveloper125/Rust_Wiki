  "name": "Rusty Yellow Pages Light",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "attribute": {
      "foreground": "#752F00"
    },
    "boolean": {
      "foreground": "#0939C8"
    },
    "builtinType": {
      "foreground": "#2B6B73"
    },
    "comment": {
      "foreground": "#156C04",
      "italic": true
    },
    "constant": {
      "bold": true,
      "foreground": "#C29B00"
    },
    "decorator": {
      "foreground": "#752F00"
    },
    "enum": {
      "foreground": "#2B6B73"
    },
    "enum.declaration": {
      "bold": true,
      "foreground": "#1189DF"
    },
    "enumMember": {
      "foreground": "#8280FF"
    },
    "function": {
      "bold": true,
      "foreground": "#D9A98A"
    },
    "function.associated": {
      "bold": true,
      "foreground": "#F5A55A"
    },
    "function.declaration": {
      "bold": true,
      "foreground": "#9966A9"
    },
    "function.static": {
      "bold": true,
      "foreground": "#F5A55A"
    },
    "interface": {
      "bold": true,
      "foreground": "#019D59"
    },
    "interface.declaration": {
      "bold": true,
      "foreground": "#1189DF"
    },
    "keyword": {
      "foreground": "#FA0000"
    },
    "lifetime": {
      "foreground": "#FD4EDD",
      "italic": true
    },
    "macro": {
      "foreground": "#D972EE"
    },
    "method": {
      "bold": true,
      "foreground": "#7004C8"
    },
    "method.declaration": {
      "bold": true,
      "foreground": "#9966A9"
    },
    "method.static": {
      "bold": true,
      "foreground": "#F5A55A"
    },
    "namespace": {
      "foreground": "#AA261D"
    },
    "number": {
      "foreground": "#0939C8"
    },
    "operator": {
      "foreground": "#180070"
    },
    "parameter": {
      "foreground": "#06C3C6"
    },
    "property": {
      "foreground": "#8280FF"
    },
    "selfKeyword": {
      "foreground": "#FA0000"
    },
    "string": {
      "foreground": "#C23B24"
    },
    "struct": {
      "foreground": "#2B6B73"
    },
    "struct.declaration": {
      "bold": true,
      "foreground": "#1189DF"
    },
    "type": {
      "foreground": "#2B6B73"
    },
    "typeAlias": {
      "foreground": "#2B6B73"
    },
    "typeAlias.declaration": {
      "bold": true,
      "foreground": "#1189DF"
    },
    "typeParameter": {
      "foreground": "#C89797",
      "italic": true
    },
    "union": {
      "foreground": "#2B6B73"
    },
    "union.declaration": {
      "bold": true,
      "foreground": "#1189DF"
    },
    "variable": {
      "foreground": "#06C3C6"
    },
    "variable.constant": {
      "bold": true,
      "foreground": "#C29B00"
    },
    "variable.static": {
      "bold": true,
      "foreground": "#C29B00"
    }
  },
  "tokenColors": [
    {
      "name": "comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#156C04"
      }
    },
    {
      "name": "string",
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#C23B24"
      }
    },
    {
      "name": "number",
      "scope": [
        "constant.numeric",
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#0939C8"
      }
    },
    {
      "name": "keyword",
      "scope": [
        "keyword",
        "storage.modifier",
        "keyword.control"
      ],
      "settings": {
        "foreground": "#FA0000"
      }
    },
    {
      "name": "macro",
      "scope": [
        "entity.name.function.macro",
        "support.function.macro"
      ],
      "settings": {
        "foreground": "#D972EE"
      }
    },
    {
      "name": "attribute",
      "scope": [
        "meta.attribute",
        "punctuation.definition.attribute"
      ],
      "settings": {
        "foreground": "#752F00"
      }
    },
    {
      "name": "lifetime",
      "scope": [
        "storage.modifier.lifetime",
        "entity.name.type.lifetime"
      ],
      "settings": {
        "foreground": "#FD4EDD"
      }
    },
    {
      "name": "punct",
      "scope": [
        "keyword.operator",
        "punctuation"
      ],
      "settings": {
        "foreground": "#180070"
      }
    }
  ],
  "type": "light"
}