    "editorWhitespace.foreground": "#1c5c5d",
    "editorWidget.background": "#0d3b3d",
    "editorWidget.border": "#1c5c5d",
    "focusBorder": "#F5C518",
    "input.background": "#0a2c2e",
    "input.border": "#1c5c5d",
    "input.foreground": "#85FDFF",
    "list.activeSelectionBackground": "#f5c51826",
    "list.hoverBackground": "#f5c51826",
    "panel.background": "#0a2c2e",
    "panel.border": "#1c5c5d",
    "sideBar.background": "#0d3b3d",
    "sideBar.border": "#1c5c5d",
    "sideBar.foreground": "#85FDFF",
    "sideBarSectionHeader.background": "#0d3b3d",
    "sideBarTitle.foreground": "#6f9c98",
    "statusBar.background": "#2b2f36",
    "statusBar.border": "#1c5c5d",
    "statusBar.foreground": "#F5C518",
    "tab.activeBackground": "#0a2c2e",
    "tab.activeBorderTop": "#F5C518",
    "tab.activeForeground": "#85FDFF",
    "tab.border": "#1c5c5d",
    "tab.inactiveBackground": "#0d3b3d",
    "tab.inactiveForeground": "#6f9c98",
    "terminal.background": "#0a2c2e",
    "terminal.foreground": "#85FDFF",
    "titleBar.activeBackground": "#2b2f36",
    "titleBar.activeForeground": "#F5C518",
    "titleBar.inactiveBackground": "#2b2f36",
    "titleBar.inactiveForeground": "#6f9c98"
  },
  "name": "Rusty Yellow Pages Dark",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "attribute": {
      "foreground": "#FED6FF"
    },
    "boolean": {
      "foreground": "#A17297"
    },
    "builtinType": {
      "foreground": "#00DDFA"
    },
    "comment": {
      "foreground": "#FFFFFF",
      "italic": true
    },
    "constant": {
      "bold": true,
      "foreground": "#E5D9A8"
    },
    "decorator": {
      "foreground": "#FED6FF"
    },
    "enum": {
      "foreground": "#00DDFA"
    },
    "enum.declaration": {
      "bold": true,
      "foreground": "#1FFF9E"
    },
    "enumMember": {
      "foreground": "#A8E2FF"
    },
    "function": {
      "bold": true,
      "foreground": "#D9A98A"
    },
    "function.associated": {
      "bold": true,
      "foreground": "#F5A55A"
    },
    "function.declaration": {
      "bold": true,
      "foreground": "#B899FF"
    },
    "function.static": {
      "bold": true,
      "foreground": "#F5A55A"
    },
    "interface": {
      "bold": true,
      "foreground": "#0084FF"
    },
    "interface.declaration": {
      "bold": true,
      "foreground": "#1FFF9E"
    },
    "keyword": {
      "foreground": "#FFB700"
    },
    "lifetime": {
      "foreground": "#F2DB69",
      "italic": true
    },
    "macro": {
      "foreground": "#D972EE"
    },
    "method": {
      "bold": true,
      "foreground": "#FFEA00"
    },
    "method.declaration": {
      "bold": true,
      "foreground": "#B899FF"
    },
    "method.static": {
      "bold": true,
      "foreground": "#F5A55A"
    },
    "namespace": {
      "foreground": "#C8D373"
    },
    "number": {
      "foreground": "#A17297"
    },
    "operator": {
      "foreground": "#FBF42D"
    },
    "parameter": {
      "foreground": "#85FDFF"
    },
    "property": {
      "foreground": "#A8E2FF"
    },
    "selfKeyword": {
      "foreground": "#FFB700"
    },
    "string": {
      "foreground": "#E26F32"
    },
    "struct": {
      "foreground": "#00DDFA"
    },
    "struct.declaration": {
      "bold": true,
      "foreground": "#1FFF9E"
    },
    "type": {
      "foreground": "#00DDFA"
    },
    "typeAlias": {
      "foreground": "#00DDFA"
    },
    "typeAlias.declaration": {
      "bold": true,
      "foreground": "#1FFF9E"
    },
    "typeParameter": {
      "foreground": "#A9D6F5",
      "italic": true
    },
    "union": {
      "foreground": "#00DDFA"
    },
    "union.declaration": {
      "bold": true,
      "foreground": "#1FFF9E"
    },
    "variable": {
      "foreground": "#85FDFF"
    },
    "variable.constant": {
      "bold": true,
      "foreground": "#E5D9A8"
    },
    "variable.static": {
      "bold": true,
      "foreground": "#E5D9A8"
    }
  },
  "tokenColors": [
    {
      "name": "comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#FFFFFF"
      }
    },
    {
      "name": "string",
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#E26F32"
      }
    },
    {
      "name": "number",
      "scope": [
        "constant.numeric",
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#A17297"
      }
    },
    {
      "name": "keyword",
      "scope": [
        "keyword",
        "storage.modifier",
        "keyword.control"
      ],
      "settings": {
        "foreground": "#FFB700"
      }
    },
    {
      "name": "macro",
      "scope": [
        "entity.name.function.macro",
        "support.function.macro"
      ],
      "settings": {
        "foreground": "#D972EE"
      }
    },
    {
      "name": "attribute",
      "scope": [
        "meta.attribute",
        "punctuation.definition.attribute"
      ],
      "settings": {
        "foreground": "#FED6FF"
      }
    },
    {
      "name": "lifetime",
      "scope": [
        "storage.modifier.lifetime",
        "entity.name.type.lifetime"
      ],
      "settings": {
        "foreground": "#F2DB69"
      }
    },
    {
      "name": "punct",
      "scope": [
        "keyword.operator",
        "punctuation"
      ],
      "settings": {
        "foreground": "#FBF42D"
      }
    }
  ],
  "type": "dark"
}