  "name": "Rusty Yellow Pages Dark",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "attribute": {
      "foreground": "#FED6FF"
    },
    "boolean": {
      "foreground": "#A17297"
    },
    "builtinType": {
      "foreground": "#00E1FF"
    },
    "comment": {
      "foreground": "#FFFFFF",
      "italic": true
    },
    "constant": {
      "bold": true,
      "foreground": "#E5D9A8"
    },
    "decorator": {
      "foreground": "#FED6FF"
    },
    "enum": {
      "foreground": "#00E1FF"
    },
    "enum.declaration": {
      "bold": true,
      "foreground": "#1FFF9E"
    },
    "enumMember": {
      "foreground": "#A8E2FF"
    },
    "function": {
      "bold": true,
      "foreground": "#D9A98A"
    },
    "function.associated": {
      "bold": true,
      "foreground": "#FFF952"
    },
    "function.declaration": {
      "bold": true,
      "foreground": "#B899FF"
    },
    "function.static": {
      "bold": true,
      "foreground": "#FFF952"
    },
    "interface": {
      "bold": true,
      "foreground": "#02AEC5"
    },
    "interface.declaration": {
      "bold": true,
      "foreground": "#1FFF9E"
    },
    "keyword": {
      "foreground": "#BABABA"
    },
    "lifetime": {
      "foreground": "#F2DB69",
      "italic": true
    },
    "macro": {
      "foreground": "#D972EE"
    },
    "method": {
      "bold": true,
      "foreground": "#FFEA00"
    },
    "method.declaration": {
      "bold": true,
      "foreground": "#B899FF"
    },
    "method.static": {
      "bold": true,
      "foreground": "#FFF952"
    },
    "namespace": {
      "foreground": "#C8D373"
    },
    "number": {
      "foreground": "#A17297"
    },
    "operator": {
      "foreground": "#FBF42D"
    },
    "parameter": {
      "foreground": "#6BFFEE"
    },
    "property": {
      "foreground": "#A8E2FF"
    },
    "selfKeyword": {
      "foreground": "#BABABA"
    },
    "string": {
      "foreground": "#FFAE00"
    },
    "struct": {
      "foreground": "#00E1FF"
    },
    "struct.declaration": {
      "bold": true,
      "foreground": "#1FFF9E"
    },
    "type": {
      "foreground": "#00E1FF"
    },
    "typeAlias": {
      "foreground": "#00E1FF"
    },
    "typeAlias.declaration": {
      "bold": true,
      "foreground": "#1FFF9E"
    },
    "typeParameter": {
      "foreground": "#A9D6F5",
      "italic": true
    },
    "union": {
      "foreground": "#00E1FF"
    },
    "union.declaration": {
      "bold": true,
      "foreground": "#1FFF9E"
    },
    "variable": {
      "foreground": "#6BFFEE"
    },
    "variable.constant": {
      "bold": true,
      "foreground": "#E5D9A8"
    },
    "variable.static": {
      "bold": true,
      "foreground": "#E5D9A8"
    }
  },
  "tokenColors": [
    {
      "name": "comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#FFFFFF"
      }
    },
    {
      "name": "string",
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#FFAE00"
      }
    },
    {
      "name": "number",
      "scope": [
        "constant.numeric",
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#A17297"
      }
    },
    {
      "name": "keyword",
      "scope": [
        "keyword",
        "storage.modifier",
        "keyword.control"
      ],
      "settings": {
        "foreground": "#BABABA"
      }
    },
    {
      "name": "macro",
      "scope": [
        "entity.name.function.macro",
        "support.function.macro"
      ],
      "settings": {
        "foreground": "#D972EE"
      }
    },
    {
      "name": "attribute",
      "scope": [
        "meta.attribute",
        "punctuation.definition.attribute"
      ],
      "settings": {
        "foreground": "#FED6FF"
      }
    },
    {
      "name": "lifetime",
      "scope": [
        "storage.modifier.lifetime",
        "entity.name.type.lifetime"
      ],
      "settings": {
        "foreground": "#F2DB69"
      }
    },
    {
      "name": "punct",
      "scope": [
        "keyword.operator",
        "punctuation"
      ],
      "settings": {
        "foreground": "#FBF42D"
      }
    }
  ],
  "type": "dark"
}