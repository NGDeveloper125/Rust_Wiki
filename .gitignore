# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/

# Rust build output
/target/
**/target/

# Local tooling: agent settings and the maintainer's skills stay out of the
# public repo. Already excluded via .git/info/exclude on the maintainer's
# machine, but that file isn't versioned — this keeps it true after a re-clone.
.claude/

# Internal design/planning docs are kept LOCAL-ONLY: every Markdown file at the
# repo root except README and CONTRIBUTING stays out of the public repo.
# (The leading slash means this only affects the root — pages/**, design notes
# in subfolders, etc. are unaffected.)
/*.md
!/README.md
!/CONTRIBUTING.md
